# Copy to .env.local for local development. Never commit real values.

# MongoDB connection string. Must be a replica set (MongoDB Atlas always is).
# Local Docker (see docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=tasklol

# Database name
MONGODB_DB=tasklol

# Signs session cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Optional tuning (defaults shown)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_MAX_POOL_SIZE=20
# How long one live-update stream stays open before the browser reconnects (ms).
# Keep it below your host's function time limit (Vercel: maxDuration=300s).
# SSE_MAX_STREAM_MS=270000
# Sign-in attempts allowed per IP per minute (accounts also lock after 5 failures).
# LOGIN_RATE_LIMIT_PER_MINUTE=20
